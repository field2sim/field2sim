# Copy this file to toolchains.env and uncomment/set only the tools you use.
# Use absolute paths to your own installations. Quote paths containing spaces.
# toolchains.env is local configuration and is excluded from Git.

# Contiki-NG directory containing tools/cooja/gradlew:
# export CONTIKI_NG="/absolute/path/to/contiki-ng"
# JDK 21 directory containing bin/java (optional if Java 21 is already selected):
# export JAVA_HOME="/absolute/path/to/jdk-21"

# ns-2 executable: use a full path, or "ns" if it is on PATH (the default).
# export NS2_BIN="/absolute/path/to/ns"

# ns-3 source/build directory containing the ns3 launcher and scratch/:
# export NS3_ROOT="/absolute/path/to/ns-3.47"

# OMNeT++ directory containing bin/opp_run_release and bin/opp_makemake:
# export OMNETPP_ROOT="/absolute/path/to/omnetpp-6.4.0"
# INET directory containing src/libINET.so (built in release mode):
# export INET_ROOT="/absolute/path/to/inet-4.7.0"
