# ns-3 Ns2MobilityHelper mobility trace generated from a WGS84-derived local ENU scenario.
# Axis convention: X=east, Y=-north, Z=local height; editor nodeId maps to node_(nodeId-1).
$node_(0) set X_ 0.000000000
$node_(0) set Y_ 0.000000000
$node_(0) set Z_ 0.000000000
$ns_ at 0.000000000 "$node_(0) setdest 3.000000000 -4.000000000 2.500000000"
$ns_ at 2.000000000 "$node_(0) setdest -2.000000000 -4.000000000 1.666666667"
$ns_ at 5.000000000 "$node_(0) setdest -2.000000000 6.000000000 2.500000000"
