  "modelDocumentation": {
    "itu-r-p1411-alpha-beta-gamma": {
      "equation": "PL(d,f)=10*alpha*log10(d)+beta+10*gamma*log10(f_GHz)",
      "rangeCalculation": "TR=10^((txPowerDbm-rxSensitivityDbm-beta-10*gamma*log10(f_GHz))/(10*alpha))"
    },
    "log-distance-fspl-reference": {
      "referenceDistanceM": 1,
      "referenceLoss": "free-space path loss at 1 m and 2.4 GHz",
      "equation": "PL(d)=FSPL(1m,2.4GHz)+10*n*log10(d/1m)",
      "rangeCalculation": "TR=10^((txPowerDbm-rxSensitivityDbm-FSPL_1m)/(10*n))"
    }
  },
  "mappingCaveats": [
    "Cooja LogisticLoss transmitting_range is both a strict candidate-receiver cutoff and the distance where mean RSSI equals rx_sensitivity.",
    "Cooja awgn_sigma is sampled independently per reception; source sigma values may represent spatial shadowing and are therefore only a parameterized approximation.",
    "The CC2420 -95 dBm figure is specified at 1% PER; placing -95 in LogisticLoss rx_sensitivity is a sensitivity-analysis substitution, not a PER-equivalent hardware calibration."
  ]
}
